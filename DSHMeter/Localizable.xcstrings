    "settings.refresh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh frequency"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新频率"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新整理頻率"
          }
        }
      }
    },
    "settings.refresh_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every 10 seconds while the popover is open; every 60 seconds in the background. Refreshes are at least 10 seconds apart. Failures retry after 30, 60, 120, then 300 seconds; rate limiting waits five minutes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹窗打开时每 10 秒刷新，后台每 60 秒刷新。查询至少间隔 10 秒。失败后按 30、60、120、300 秒退避；限流时等待五分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "彈出視窗開啟時每 10 秒重新整理，背景每 60 秒重新整理。查詢至少間隔 10 秒。失敗後依 30、60、120、300 秒延後重試；限流時等待五分鐘。"
          }
        }
      }
    },
