    "backup.confirm_message": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This replaces history for ALL accounts on this Mac. An automatic backup is saved first. You must quit and reopen the app after restoring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会替换这台 Mac 上所有账号的历史，恢复前会自动保存现有数据的备份。完成后需要退出并重新打开 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會取代這台 Mac 上所有帳號的歷史，還原前會自動儲存現有資料的備份。完成後需要結束並重新開啟 App。"
          }
        }
      }
    },
    "backup.confirm_title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace all local history?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替换全部本地历史？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取代全部本機歷史？"
          }
        }
      }
    },
    "backup.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back up retained history for all accounts, including account-matching metadata. Login credentials and app settings are not included. Keep backups private; expired records cannot be recovered."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份所有账号当前保留的历史，包含账号匹配信息，不包含登录凭据或 App 设置。请妥善保管备份；已被保留期限清理的数据无法找回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "备份所有账号当前保留的历史，包含账号匹配信息，不包含登录凭据或 App 设置。请妥善保管备份；已被保留期限清理的数据无法找回。"
          }
        }
      }
    },
