    "settings.push.credentials_error": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to save or read push credentials in Keychain. Check this Mac’s Keychain access and try again; macOS may ask for approval. Previous stored credentials are retained if saving fails, but unsaved changes may not survive restart."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在钥匙串中保存或读取推送密钥。请检查此 Mac 的钥匙串访问权限后重试，macOS 可能要求授权。保存失败时会保留原有密钥，但未保存的更改可能在重启后丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在鑰匙圈中儲存或讀取推播金鑰。請檢查此 Mac 的鑰匙圈存取權限後重試，macOS 可能要求授權。儲存失敗時會保留原有金鑰，但未儲存的變更可能在重新啟動後遺失。"
          }
        }
      }
    },
    "settings.push.error.invalid_configuration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid or incomplete push configuration. Check the server address and credentials; use HTTPS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推送配置无效或不完整。请检查服务器地址和密钥，并使用 HTTPS。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "推播設定無效或不完整。請檢查伺服器網址和金鑰，並使用 HTTPS。"
          }
        }
      }
    },
    "settings.push.error.network": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification could not be delivered after retrying. Check your network connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试后仍无法发送通知，请检查网络连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重試後仍無法傳送通知，請檢查網路連線。"
          }
        }
      }
    },
    "settings.push.error.http": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server refused the notification. Check the credentials, destination and server availability."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器未接受通知，请检查密钥、发送目标和服务器状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器未接受通知，請檢查金鑰、傳送目標和伺服器狀態。"
          }
        }
      }
    },
    "settings.push.error.rejected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The push service did not confirm delivery. Check its configuration and try a test notification."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推送服务未确认接收。请检查配置并尝试发送测试通知。"
