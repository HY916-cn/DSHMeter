    "error.cancelled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request was cancelled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查询已取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查詢已取消。"
          }
        }
      }
    },
    "error.credential_malformed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The DSH credential format is not supported. Check the DSH folder, or sign in again in DSH. See the project README via Settings → About for setup steps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DSH 凭据格式无法识别。请检查 DSH 目录，或在 DSH 中重新登录。 请前往“设置 → 关于”的项目 README 查看详细教程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法識別 DSH 憑據格式。請檢查 DSH 目錄，或在 DSH 中重新登入。 請前往「設定 → 關於」的專案 README 查看詳細教學。"
          }
        }
      }
    },
    "error.credential_missing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No signed-in DeepSeek account or API Key was found. Open DSH and sign in, then refresh. See the project README via Settings → About for setup steps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到已登录的 DeepSeek 账号或 API Key。请打开 DSH 完成账号登录后刷新。 请前往“设置 → 关于”的项目 README 查看详细教程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到已登入的 DeepSeek 帳戶或 API Key。請開啟 DSH 完成帳戶登入後重新整理。 請前往「設定 → 關於」的專案 README 查看詳細教學。"
          }
        }
      }
    },
    "error.credential_permissions": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The DSH credential file must belong to your user and be readable only by you. See README for the permission repair command. See the project README via Settings → About for setup steps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DSH 凭据文件须归当前用户所有，且只允许当前用户访问。请查看 README 中的权限修复命令。 请前往“设置 → 关于”的项目 README 查看详细教程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DSH 憑據檔案須屬於目前使用者，且只允許目前使用者存取。請查看 README 中的權限修復指令。 請前往「設定 → 關於」的專案 README 查看詳細教學。"
          }
        }
      }
    },
    "error.credential_unreadable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot read the DSH credential file. Check the DSH folder in Settings and its read permissions. See the project README via Settings → About for setup steps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取 DSH 凭据文件。请检查设置中的 DSH 目录及文件读取权限。 请前往“设置 → 关于”的项目 README 查看详细教程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取 DSH 憑據檔案。請檢查設定中的 DSH 目錄及檔案讀取權限。 請前往「設定 → 關於」的專案 README 查看詳細教學。"
          }
        }
      }
    },
    "error.network": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot connect to DeepSeek. Check your connection and system proxy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 DeepSeek，请检查网络及系统代理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線 DeepSeek，請檢查網路及系統代理。"
          }
        }
      }
    },
    "error.rate_limited": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek is limiting balance queries. The last successful balance is kept; retrying in five minutes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek 限制了余额查询频率。已保留上次成功余额，将在五分钟后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek 限制了餘額查詢頻率。已保留上次成功餘額，將於五分鐘後重試。"
          }
        }
      }
    },
    "error.redirect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance endpoint redirected the request. No credentials were forwarded. Please try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "余额接口发生重定向，已停止请求以保护密钥。请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "餘額介面發生重新導向，已停止請求以保護金鑰。請稍後重試。"
          }
        }
      }
    },
    "error.response": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek returned an unexpected response. Please try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek 返回了无法识别的响应，请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek 傳回無法識別的回應，請稍後重試。"
          }
        }
      }
    },
    "error.retry_at": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic retry at"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将在以下时间自动重试："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將於以下時間自動重試："
          }
        }
      }
    },
    "error.server": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek is temporarily unavailable. Waiting to retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek 服务暂时不可用，正在等待重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek 服務暫時無法使用，正在等待重試。"
          }
        }
      }
    },
    "error.timeout": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance request timed out. Waiting to retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "余额查询超时，正在等待重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "餘額查詢逾時，正在等待重試。"
          }
        }
      }
    },
    "error.unauthorized": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek authentication has expired or was rejected. Sign in again in DSH; if using an API Key, check it in DSH model settings. See the project README via Settings → About for setup steps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek 认证已失效或被拒绝。请在 DSH 中重新登录；使用 API Key 时，请在模型设置中检查密钥。 请前往“设置 → 关于”的项目 README 查看详细教程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek 驗證已失效或遭拒絕。請在 DSH 中重新登入；使用 API Key 時，請在模型設定中檢查金鑰。 請前往「設定 → 關於」的專案 README 查看詳細教學。"
          }
        }
      }
    },
