    "settings.credentials_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically reuses DEEPSEEK_API_KEY saved by DSH. The credential file is read only; the key is sent only to the official DeepSeek balance endpoint."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动复用 DSH 已保存的 DEEPSEEK_API_KEY。只读访问凭据文件，密钥仅发送至 DeepSeek 官方余额接口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動使用 DSH 已儲存的 DEEPSEEK_API_KEY。以唯讀方式存取憑據檔案，金鑰僅傳送至 DeepSeek 官方餘額介面。"
          }
        }
      }
    },
    "settings.currency_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the selected currency when returned by DeepSeek; otherwise shows the first available currency. Currencies are not converted or added together."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先显示所选币种；接口未返回时显示首个可用币种。不同币种分别显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "優先顯示所選幣別；介面未傳回時顯示第一個可用幣別。不同幣別分別顯示。"
          }
        }
      }
    },
