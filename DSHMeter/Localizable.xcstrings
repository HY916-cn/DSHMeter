    "settings.popover.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how balance appears in the menu bar. Rings and bars show the topped-up and granted shares of the current balance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义菜单栏余额的显示方式。进度环和横条表示当前余额中的充值与赠送占比。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂選單列餘額的顯示方式。進度環與橫條表示目前餘額中的儲值與贈送占比。"
          }
        }
      }
