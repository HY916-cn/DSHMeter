{
  "sourceLanguage": "en",
  "strings": {
    "about.credits": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Credits"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "致谢"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "致謝"
          }
        }
      }
    },
    "about.credits_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on the native menu bar layout of Raycal’s CodexMeter and HY916-cn’s ClaudeMeter. YAML support by Yams. Licensed under MIT."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿用 Raycal 的 CodexMeter 与 HY916-cn 的 ClaudeMeter 原生菜单栏布局。YAML 解析使用 Yams，采用 MIT 许可。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沿用 Raycal 的 CodexMeter 與 HY916-cn 的 ClaudeMeter 原生選單列配置。YAML 解析使用 Yams，採用 MIT 授權。"
          }
        }
      }
    },
    "about.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A native macOS menu bar monitor for the DeepSeek API balance used by DSH. Community project."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生 macOS 菜单栏工具，查看 DSH 所用 DeepSeek API 的账户余额。社区项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原生 macOS 選單列工具，查看 DSH 所用 DeepSeek API 的帳戶餘額。社群專案。"
          }
        }
      }
    },
    "about.license": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "License and credits"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "许可与致谢"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "授權與致謝"
          }
        }
      }
    },
    "about.local_data": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local configuration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地配置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機設定"
          }
        }
      }
    },
    "about.local_data_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The DSH folder used to read the saved DeepSeek API Key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于读取已保存 DeepSeek API Key 的 DSH 目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於讀取已儲存 DeepSeek API Key 的 DSH 目錄。"
          }
        }
      }
    },
    "about.privacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐私"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱私"
          }
        }
      }
    },
    "about.privacy_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads only the named DeepSeek API Key from DSH credential sources. The key stays in memory and is sent only to api.deepseek.com/user/balance over HTTPS. Balance data stays in memory. No model requests, telemetry, or conversation access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅读取 DSH 凭据来源中的指定 DeepSeek API Key。密钥仅保留在内存，并通过 HTTPS 发送至 api.deepseek.com/user/balance。余额数据保留在内存，不发起模型请求、不收集遥测、不访问对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅讀取 DSH 憑據來源中的指定 DeepSeek API Key。金鑰僅保留於記憶體，並透過 HTTPS 傳送至 api.deepseek.com/user/balance。餘額資料保留於記憶體，不發起模型請求、不收集遙測、不存取對話。"
          }
        }
      }
    },
    "about.version_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@ · Build %@"
          }
        },
        "zh-Hans": {
