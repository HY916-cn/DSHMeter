    "settings.push.telegram_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a bot with @BotFather, start a chat with it (or add it to your group), and enter the destination Chat ID. A bot cannot initiate a private chat before you start it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 @BotFather 创建机器人，先与它开始聊天（或将它加入群组），再填写目标聊天 ID。未开始聊天前，机器人不能主动给你发送私信。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 @BotFather 建立機器人，先與它開始聊天（或將它加入群組），再填寫目標聊天 ID。尚未開始聊天前，機器人無法主動傳送私訊。"
          }
        }
      }
    },
