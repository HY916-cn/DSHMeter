    "about.privacy_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DSHMeter reads the DSH account credential to request balances from DeepSeek. Credentials remain in memory. Optional balance-reference history is stored on this Mac. Remote notifications are sent only to channels you configure; push credentials stay in Keychain. No chats or telemetry are collected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DSHMeter 只读 DSH 账号凭据并向 DeepSeek 查询余额，凭据仅保留在内存。可选的参考余额比例历史保存在这台 Mac。远程通知仅发送至你配置的渠道，推送凭据保存在钥匙串中。不读取会话、不收集遥测。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DSHMeter 只读 DSH 账号凭据并向 DeepSeek 查询余额，凭据仅保留在内存。可选的参考余额比例历史保存在这台 Mac。远程通知仅发送至你配置的渠道，推送凭据保存在钥匙串中。不读取会话、不收集遥测。"
          }
        }
      }
    },
