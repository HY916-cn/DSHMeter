    "error.cancelled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request was cancelled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查询已取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查詢已取消。"
          }
        }
      }
    },
    "error.credential_malformed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DSH credentials could not be parsed. Save the DeepSeek API Key again in DSH, or check the configuration format in README."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DSH 凭据格式无法识别。请在 DSH 中重新保存 DeepSeek API Key，或查看 README 检查配置格式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法識別 DSH 憑據格式。請在 DSH 中重新儲存 DeepSeek API Key，或查看 README 檢查設定格式。"
          }
        }
      }
    },
    "error.credential_missing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No DeepSeek API Key found in DSH. Open DSH → Settings → Models, save a DeepSeek API Key, then refresh. Signing into DSH alone may not configure an API Key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DSH 中未找到 DeepSeek API Key。请打开 DSH → 设置 → 模型，保存 DeepSeek API Key 后刷新。仅登录 DSH 账户可能尚未配置 API Key。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DSH 中找不到 DeepSeek API Key。請開啟 DSH → 設定 → 模型，儲存 DeepSeek API Key 後重新整理。僅登入 DSH 帳戶可能尚未設定 API Key。"
          }
        }
      }
    },
    "error.credential_permissions": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The DSH credential file must belong to your user and be readable only by you. See README for the permission repair command."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DSH 凭据文件须归当前用户所有，且只允许当前用户访问。请查看 README 中的权限修复命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DSH 憑據檔案須屬於目前使用者，且只允許目前使用者存取。請查看 README 中的權限修復指令。"
          }
        }
      }
    },
    "error.credential_unreadable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot read the DSH credential file. Check the DSH folder in Settings and its read permissions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取 DSH 凭据文件。请检查设置中的 DSH 目录及文件读取权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取 DSH 憑據檔案。請檢查設定中的 DSH 目錄及檔案讀取權限。"
          }
        }
      }
    },
    "error.network": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot connect to DeepSeek. Check your connection and system proxy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 DeepSeek，请检查网络及系统代理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線 DeepSeek，請檢查網路及系統代理。"
          }
        }
      }
    },
    "error.rate_limited": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek is limiting balance queries. The last successful balance is kept; retrying in five minutes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek 限制了余额查询频率。已保留上次成功余额，将在五分钟后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek 限制了餘額查詢頻率。已保留上次成功餘額，將於五分鐘後重試。"
          }
        }
      }
    },
    "error.redirect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance endpoint redirected the request. No credentials were forwarded. Please try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "余额接口发生重定向，已停止请求以保护密钥。请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "餘額介面發生重新導向，已停止請求以保護金鑰。請稍後重試。"
          }
        }
      }
    },
    "error.response": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek returned an unexpected response. Please try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
