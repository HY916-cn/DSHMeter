            "value": "The menu bar shows money by default. Set a positive reference amount to enable a remaining-balance ring or bar. The reference is only a display baseline, not a spending limit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏默认显示余额金额。设置正数参考金额后，可显示“当前余额 ÷ 参考余额”的进度环或横条。参考值仅用于显示，不限制消费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選單列預設顯示餘額金額。設定正數參考金額後，可顯示「目前餘額 ÷ 參考餘額」的進度環或橫條。參考值僅用於顯示，不限制消費。"
          }
        }
      }
    },
    "balance.reference_optional": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional amount"
          }
        },
        "zh-Hans": {
